# Compiled JSON is written byte-for-byte by stage_jo.py.
# Never let git rewrite line endings here: a CRLF pass would make all
# ~30 files look changed even when the content is identical, which breaks
# both "copy only what changed" and the A->B->A revert check.
jo/data/*.json -text

# minbeop/index.html is the master copy of the app itself (the vault copy gets deleted).
# Keep it byte-identical so its md5 can be tracked across machines.
minbeop/index.html -text
