{
 "app": "timetable",
 "base": "90bd89b",
 "settle_ms": 1500,
 "screens": {
  "p1": {
   "dev": "pc",
   "setup": "(async()=>{recImportModal();document.getElementById('recPv').style.display='block';const L=[];for(let i=0;i<60;i++){const d=new Date(Date.UTC(2025,0,1+i)).toISOString().slice(0,10);L.push({d:d,app:'관문시험',subj:'시험',unit:'u'+(i%3),ulabel:'시험 단원',n:3,o:1,x:1,q:1,src:'paste'})}recPreviewSet(L,'');await new Promise(r=>setTimeout(r,300));return 'ok'})()"
  },
  "m1": {
   "dev": "ph",
   "setup": "(async()=>{recImportModal();document.getElementById('recPv').style.display='block';const L=[];for(let i=0;i<60;i++){const d=new Date(Date.UTC(2025,0,1+i)).toISOString().slice(0,10);L.push({d:d,app:'관문시험',subj:'시험',unit:'u'+(i%3),ulabel:'시험 단원',n:3,o:1,x:1,q:1,src:'paste'})}recPreviewSet(L,'');await new Promise(r=>setTimeout(r,300));return 'ok'})()"
  }
 },
 "tests": [
  {
   "name": "PC 날짜 60 일 · 체크 60(바탕과 같음)",
   "screen": "p1",
   "act": "none",
   "wait": 300,
   "yard": false,
   "expect": "recPrev&&recPrev.chk.size===60||(recPrev&&recPrev.chk.size)"
  },
  {
   "name": "PC 「가져오기」 단추 = 굴리지 않아도 화면 안",
   "screen": "p1",
   "act": "none",
   "wait": 300,
   "yard": true,
   "expect": "(()=>{const r=document.getElementById('recGo').getBoundingClientRect();return r.top>=0&&r.bottom<=innerHeight||JSON.stringify([Math.round(r.top),Math.round(r.bottom),innerHeight])})()"
  },
  {
   "name": "PC 날짜 목록만 굴림(목록 높이 ≤ 화면 절반)",
   "screen": "p1",
   "act": "none",
   "wait": 300,
   "yard": true,
   "expect": "(()=>{const p=document.getElementById('recPv');return p.scrollHeight>p.clientHeight&&getComputedStyle(p).overflowY==='auto'&&p.clientHeight<=innerHeight*0.5||JSON.stringify([p.scrollHeight,p.clientHeight])})()"
  },
  {
   "name": "PC 상자 = 화면 안(넘치면 상자 안에서 굴림)",
   "screen": "p1",
   "act": "none",
   "wait": 300,
   "yard": true,
   "expect": "(()=>{const b=document.querySelector('#recImpM .box').getBoundingClientRect();return b.top>=0&&b.bottom<=innerHeight||JSON.stringify([Math.round(b.top),Math.round(b.bottom),innerHeight])})()"
  },
  {
   "name": "PC 「가져오기」 누름 → 창 닫힘(가져옴)",
   "screen": "p1",
   "act": "click",
   "sel": "#recGo",
   "wait": 800,
   "yard": true,
   "expect": "!document.getElementById('recImpM')"
  },
