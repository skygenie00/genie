"expect": "(()=>{const f=document.querySelector('#navdr .ndtt .pnfr');return !!f&&f.classList.contains('blk')&&getComputedStyle(f).backgroundColor==='rgb(31, 35, 41)'&&tfixRaw('P110','nmk')==='1'})()",
"yard": true,
"act": "none"
},
{
