}
},
"tests": [
{
"name": "PC 서랍 제목 길게 = 고치는 칸 · 테두리 틀 파랑",
"screen": "p1",
"wait": 800,
"expect": "(()=>{const f=document.querySelector('#navdr .ndtt .pnfr');return !!f&&!f.classList.contains('blk')&&getComputedStyle(f).backgroundColor==='rgb(79, 134, 217)'})()",
"yard": true,
"act": "long",
"hold": 800,
"sel": "#navdr .ndtt[data-pn=\"110\"]"
},
{
"name": "PC 테두리 누름 = 틀 검정 · 저장",
"screen": "p1",
"wait": 100,
"expect": "(sel=>{const f=document.querySelector(sel);if(!f)return 'no frame';const b=f.getBoundingClientRect(),x=b.left+2,y=b.top+b.height/2,t=document.elementFromPoint(x,y);if(t!==f)return 'edge='+(t&&t.className);t.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true,clientX:x,clientY:y,pointerId:5,isPrimary:true,pointerType:'touch'}));return true})('#navdr .ndtt .pnfr')",
"yard": true,
"act": "none"
},
{
"name": "PC 누른 뒤 확인(틀 검정 · nmk · 칸 그대로 열림)",
